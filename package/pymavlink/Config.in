config BR2_PACKAGE_PYMAVLINK
	bool "Pymavlink"
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_MAVLINK
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_FUTURE
	select BR2_PACKAGE_PYTHON_LXML
	help
	  python MAVLink interface and utilities.

	  https://ardupilot.org/dev/docs/mavlink-commands.html
