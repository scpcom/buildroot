From 6b87256393e1231ca99354dcb1c3a2f9b458f24e Mon Sep 17 00:00:00 2001
From: scpcom <scpcom@gmx.de>
Date: Tue, 14 Oct 2025 20:42:40 +0200
Subject: [PATCH] Add HID mode selection

---
 web/src/i18n/locales/de.ts                    | 12 +++--
 web/src/i18n/locales/en.ts                    | 12 +++--
 web/src/pages/desktop/menu/mouse/hid-mode.tsx | 47 +++++++++++++++----
 4 files changed, 55 insertions(+), 20 deletions(-)

diff --git a/web/src/i18n/locales/de.ts b/web/src/i18n/locales/de.ts
index e460c72..5ad374a 100644
--- a/web/src/i18n/locales/de.ts
+++ b/web/src/i18n/locales/de.ts
@@ -89,14 +89,18 @@ const de = {
         'Relativer Modus aktiv. Klicken Sie auf den Desktop um den Mauszeiger zu sehen.',
       resetHid: 'HID zurücksetzen',
       biosHid: 'HID BIOS-Modus',
-      hidOnly: {
-        title: 'HID-Only-Modus',
+      hidMode: {
+        title: 'HID Modus',
         desc: 'Wenn Ihre Maus und Tastatur nicht mehr reagieren und das Zurücksetzen der HID-Verbindung nicht hilft, könnte es sich um ein Kompatibilitätsproblem zwischen dem NanoKVM und dem Gerät handeln. Versuchen Sie, den HID-Only Modus zu aktivieren, um die Kompatibilität zu verbessern.',
         tip1: 'Die Aktivierung des HID-Only Modus entfernt das virtuelle U-Laufwerk und das virtuelle Netzwerk.',
         tip2: 'Im HID-Only Modus ist das Einbinden von Systemabbilder deaktiviert.',
         tip3: 'NanoKVM wird nach dem Wechsel in den neuen Modus HID zurücksetzen.',
-        enable: 'HID-Only Modus aktivieren',
-        disable: 'HID-Only Modus deaktivieren'
+        normal: 'Normal',
+        hidonly: 'HID-Only',
+        kbdonly: 'Keyboard-Only',
+        nohid: 'Kein HID',
+        enable: 'Aktivieren',
+        close: 'Schließen'
       }
     },
     image: {
diff --git a/web/src/i18n/locales/en.ts b/web/src/i18n/locales/en.ts
index b7fd4fe..9934083 100644
--- a/web/src/i18n/locales/en.ts
+++ b/web/src/i18n/locales/en.ts
@@ -93,14 +93,18 @@ const en = {
       requestPointer: 'Using relative mode. Please click desktop to get mouse pointer.',
       resetHid: 'Reset HID',
       biosHid: 'HID BIOS mode',
-      hidOnly: {
-        title: 'HID-Only mode',
+      hidMode: {
+        title: 'HID mode',
         desc: "If your mouse and keyboard stop responding and resetting HID doesn't help, it could be a compatibility issue between the NanoKVM and the device. Try to enable HID-Only mode for better compatibility.",
         tip1: 'Enabling HID-Only mode will unmount the virtual U-disk and virtual network',
         tip2: 'In HID-Only mode, image mounting is disabled',
         tip3: 'NanoKVM will reset HID after switching modes',
-        enable: 'Enable HID-Only mode',
-        disable: 'Disable HID-Only mode'
+        normal: 'Normal',
+        hidonly: 'HID-Only',
+        kbdonly: 'Keyboard-Only',
+        nohid: 'No HID',
+        enable: 'Enable',
+        close: 'Close'
       }
     },
     image: {
diff --git a/web/src/pages/desktop/menu/mouse/hid-mode.tsx b/web/src/pages/desktop/menu/mouse/hid-mode.tsx
index eb6341d..728541e 100644
--- a/web/src/pages/desktop/menu/mouse/hid-mode.tsx
+++ b/web/src/pages/desktop/menu/mouse/hid-mode.tsx
@@ -1,5 +1,5 @@
 import { useEffect, useState } from 'react';
-import { Button, Divider, Modal, Typography } from 'antd';
+import { Button, Divider, Modal, Select, Typography } from 'antd';
 import clsx from 'clsx';
 import { PenIcon } from 'lucide-react';
 import { useTranslation } from 'react-i18next';
@@ -13,11 +13,19 @@ const { Paragraph } = Typography;
 export const HidMode = () => {
   const { t } = useTranslation();
 
-  const [hidMode, setHidMode] = useState<'normal' | 'hid-only'>('normal');
+  const [hidMode, setHidMode] = useState<'normal' | 'hid-only' | 'kbd-only' | 'no-hid'>('normal');
+  const [toggleMode, setToggleMode] = useState('');
   const [isLoading, setIsLoading] = useState(false);
   const [isModalOpen, setIsModalOpen] = useState(false);
   const [errMsg, setErrMsg] = useState('');
 
+  const ModeOptions = [
+    { value: 'normal', label: t('mouse.hidMode.normal') },
+    { value: 'hid-only', label: t('mouse.hidMode.hidonly') },
+    { value: 'kbd-only', label: t('mouse.hidMode.kbdonly') },
+    { value: 'no-hid', label: t('mouse.hidMode.nohid') },
+  ];
+
   useEffect(() => {
     getHidMode();
   }, []);
@@ -41,6 +49,11 @@ export const HidMode = () => {
   }
 
   function updateHidMode() {
+    if (hidMode === toggleMode || toggleMode === '') {
+      setIsModalOpen(false);
+      return;
+    }
+
     if (isLoading) return;
     setIsLoading(true);
 
@@ -48,7 +61,7 @@ export const HidMode = () => {
       window.location.reload();
     }, 30000);
 
-    const mode = hidMode === 'normal' ? 'hid-only' : 'normal';
+    const mode = toggleMode;
 
     api
       .setHidMode(mode)
@@ -71,17 +84,17 @@ export const HidMode = () => {
       <div
         className={clsx(
           'flex h-[30px] cursor-pointer select-none items-center space-x-2 rounded px-3 hover:bg-neutral-700/70',
-          hidMode === 'hid-only' ? 'text-blue-500' : 'text-neutral-300'
+          hidMode === 'hid-only' ? 'text-blue-500' : hidMode === 'kbd-only' ? 'text-blue-500' : hidMode === 'no-hid' ? 'text-yellow-400' : 'text-neutral-300'
         )}
         onClick={() => setIsModalOpen(true)}
       >
         <PenIcon size={18} />
-        <span>{t('mouse.hidOnly.title')}</span>
+        <span>{t('mouse.hidMode.title')}</span>
       </div>
 
       <Modal
         open={isModalOpen}
-        title={t('mouse.hidOnly.title')}
+        title={t('mouse.hidMode.title')}
         width={580}
         centered={false}
         footer={false}
@@ -89,21 +102,35 @@ export const HidMode = () => {
       >
         <Divider />
 
-        <Paragraph>{t('mouse.hidOnly.desc')}</Paragraph>
+        <Paragraph>{t('mouse.hidMode.desc')}</Paragraph>
 
         <Paragraph type="secondary">
           <ul>
-            <li>{t('mouse.hidOnly.tip1')}</li>
-            <li>{t('mouse.hidOnly.tip2')}</li>
-            <li>{t('mouse.hidOnly.tip3')}</li>
+            <li>{t('mouse.hidMode.tip1')}</li>
+            <li>{t('mouse.hidMode.tip2')}</li>
+            <li>{t('mouse.hidMode.tip3')}</li>
           </ul>
         </Paragraph>
 
+        <div className="flex items-center justify-between">
+          <div className="flex items-center space-x-1">
+            <PenIcon size={16} />
+            <span>{t('mouse.hidMode.title')}</span>
+          </div>
+
+          <Select
+            defaultValue={hidMode}
+            style={{ width: 180 }}
+            options={ModeOptions}
+            onSelect={setToggleMode}
+          />
+        </div>
+
         {errMsg && <div className="pt-1 text-sm text-red-500">{errMsg}</div>}
 
         <div className="flex justify-center pt-5">
           <Button danger type="primary" loading={isLoading} onClick={updateHidMode}>
-            {hidMode === 'normal' ? t('mouse.hidOnly.enable') : t('mouse.hidOnly.disable')}
+            {hidMode === toggleMode ? t('mouse.hidMode.close') : toggleMode === '' ? t('mouse.hidMode.close') : t('mouse.hidMode.enable')}
           </Button>
         </div>
       </Modal>
-- 
2.34.1

