From c87f99146938d0f69cd954ab6de2284df1ab1c6a Mon Sep 17 00:00:00 2001
From: scpcom <scpcom@gmx.de>
Date: Fri, 10 Oct 2025 21:00:54 +0200
Subject: [PATCH] server: storage: mount: lock hid

---
 server/service/storage/image.go | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/server/service/storage/image.go b/server/service/storage/image.go
index c1a54d2..6ca39a5 100644
--- a/server/service/storage/image.go
+++ b/server/service/storage/image.go
@@ -12,6 +12,7 @@ import (
 	log "github.com/sirupsen/logrus"
 
 	"NanoKVM-Server/proto"
+	"NanoKVM-Server/service/hid"
 )
 
 const (
@@ -106,6 +107,14 @@ func (s *Service) MountImage(c *gin.Context) {
 		return
 	}
 
+	h := hid.GetHid()
+	h.Lock()
+	h.CloseNoLock()
+	defer func() {
+		h.OpenNoLock()
+		h.Unlock()
+	}()
+
 	// reset usb
 	commands := []string{
 		"echo > /sys/kernel/config/usb_gadget/g0/UDC",
-- 
2.34.1

