From 5b583d34f9c221e64b8e932dfe783df807b334a0 Mon Sep 17 00:00:00 2001
From: scpcom <scpcom@gmx.de>
Date: Sat, 10 May 2025 15:31:35 +0200
Subject: [PATCH 2/2] kvm_mmf: fix use after free on venc pstPack

---
 .../sg2002/additional/kvm_mmf/src/kvm_mmf.cpp | 32 +++++++++++--------
 1 file changed, 19 insertions(+), 13 deletions(-)

diff --git a/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp b/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
index 98bd6fc..f32fec1 100644
--- a/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
+++ b/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
@@ -1994,10 +1994,14 @@ int mmf_enc_jpg_pop(int ch, uint8_t **data, int *size)
 		s32Ret = CVI_VENC_GetStream(ch, &priv.enc_jpeg_frame, 1000);
 		if (s32Ret != CVI_SUCCESS) {
 			printf("CVI_VENC_GetStream failed with %#x\n", s32Ret);
+			free(priv.enc_jpeg_frame.pstPack);
+			priv.enc_jpeg_frame.pstPack = NULL;
 			return s32Ret;
 		}
 	} else {
 		printf("CVI_VENC_QueryStatus find not pack\r\n");
+		free(priv.enc_jpeg_frame.pstPack);
+		priv.enc_jpeg_frame.pstPack = NULL;
 		return -1;
 	}
 
@@ -2016,13 +2020,13 @@ int mmf_enc_jpg_free(int ch)
 		return s32Ret;
 	}
 
-	s32Ret = CVI_VENC_ReleaseStream(ch, &priv.enc_jpeg_frame);
-	if (s32Ret != CVI_SUCCESS) {
-		printf("CVI_VENC_ReleaseStream failed with %#x\n", s32Ret);
-		return s32Ret;
-	}
-
 	if (priv.enc_jpeg_frame.pstPack) {
+		s32Ret = CVI_VENC_ReleaseStream(ch, &priv.enc_jpeg_frame);
+		if (s32Ret != CVI_SUCCESS) {
+			printf("CVI_VENC_ReleaseStream failed with %#x\n", s32Ret);
+			return s32Ret;
+		}
+
 		free(priv.enc_jpeg_frame.pstPack);
 		priv.enc_jpeg_frame.pstPack = NULL;
 	}
@@ -2351,11 +2355,13 @@ int mmf_venc_pop(int ch, mmf_stream_t *stream) {
 		if (s32Ret != CVI_SUCCESS) {
 			printf("CVI_VENC_GetStream failed with %#x\n", s32Ret);
 			free(venc_stream->pstPack);
+			venc_stream->pstPack = NULL;
 			return s32Ret;
 		}
 	} else {
 		printf("CVI_VENC_QueryStatus find not pack\r\n");
 		free(venc_stream->pstPack);
+		venc_stream->pstPack = NULL;
 		return -1;
 	}
 
@@ -2363,7 +2369,7 @@ int mmf_venc_pop(int ch, mmf_stream_t *stream) {
 		stream->count = venc_stream->u32PackCount;
 		if (stream->count > 8) {
 			printf("pack count is too large! cnt:%d\r\n", stream->count);
-			free(venc_stream->pstPack);
+			mmf_venc_free(ch);
 			return -1;
 		}
 		for (int i = 0; i < stream->count; i++) {
@@ -2388,13 +2394,13 @@ int mmf_venc_free(int ch) {
 		return s32Ret;
 	}
 
-	s32Ret = CVI_VENC_ReleaseStream(ch, venc_stream);
-	if (s32Ret != CVI_SUCCESS) {
-		printf("CVI_VENC_ReleaseStream failed with %#x\n", s32Ret);
-		return s32Ret;
-	}
-
 	if (venc_stream->pstPack) {
+		s32Ret = CVI_VENC_ReleaseStream(ch, venc_stream);
+		if (s32Ret != CVI_SUCCESS) {
+			printf("CVI_VENC_ReleaseStream failed with %#x\n", s32Ret);
+			return s32Ret;
+		}
+
 		free(venc_stream->pstPack);
 		venc_stream->pstPack = NULL;
 	}
-- 
2.34.1

