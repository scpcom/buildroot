From a9d9637957ca73356285c644d0d74a1448882913 Mon Sep 17 00:00:00 2001
From: scpcom <scpcom@gmx.de>
Date: Sat, 10 May 2025 14:21:11 +0200
Subject: [PATCH] kvm_mmf: fix glitch at picture bottom

---
 support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp b/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
index 536f9e2..90e4e0b 100644
--- a/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
+++ b/support/sg2002/additional/kvm_mmf/src/kvm_mmf.cpp
@@ -1839,7 +1839,10 @@ int mmf_enc_jpg_push_with_quality(int ch, uint8_t *data, int w, int h, int forma
 							((uint8_t *)data) + w * h, w);
 				}
 			} else {
-				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[0], ((uint8_t *)data), w * h * 3 / 2);
+				uint32_t p0_size = w * h;
+				uint32_t p1_size = w * h / 2;
+				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[0], ((uint8_t *)data), p0_size);
+				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[1], ((uint8_t *)data) + p0_size, p1_size);
 			}
 
 			s32Ret = CVI_VENC_SendFrame(ch, priv.enc_jpg_frame, 1000);
@@ -1907,7 +1910,10 @@ int mmf_enc_jpg_push(int ch, uint8_t *data, int w, int h, int format)
 							((uint8_t *)data) + w * h, w);
 				}
 			} else {
-				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[0], ((uint8_t *)data), w * h * 3 / 2);
+				uint32_t p0_size = w * h;
+				uint32_t p1_size = w * h / 2;
+				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[0], ((uint8_t *)data), p0_size);
+				memcpy(priv.enc_jpg_frame->stVFrame.pu8VirAddr[1], ((uint8_t *)data) + p0_size, p1_size);
 			}
 
 			s32Ret = CVI_VENC_SendFrame(ch, priv.enc_jpg_frame, 1000);
@@ -2227,7 +2233,10 @@ int mmf_venc_push(int ch, uint8_t *data, int w, int h, int format) {
 							((uint8_t *)data) + w * h0, w);
 				}
 			} else {
-				memcpy((uint8_t *)frame_info->stVFrame.pu8VirAddr[0], ((uint8_t *)data), w * h * 3 / 2);
+				uint32_t p0_size = w * h;
+				uint32_t p1_size = w * h / 2;
+				memcpy(frame_info->stVFrame.pu8VirAddr[0], ((uint8_t *)data), p0_size);
+				memcpy(frame_info->stVFrame.pu8VirAddr[1], ((uint8_t *)data) + p0_size, p1_size);
 			}
 		}
 		break;
