#!/bin/sh

if [ "$1" = "start" ]
then
	. /etc/profile
	fb=none
	[ ! -e /boot/fb ] || fb=$(cat /boot/fb)
	for f in  /mnt/system/ko/fb_*.ko
	do
		b=$(basename $f | sed s/'\.ko$'/''/g)
		[ $b = fb_${fb} ] || rmmod $b
	done
	if [ -e /mnt/system/ko/fb_${fb}.ko ]
	then
		echo "framebuffer enable"
		insmod /mnt/system/ko/fb_${fb}.ko
	elif [ -e /boot/fb ]
	then
		echo "framebuffer enable"
		insmod /mnt/system/ko/soph_fb.ko
		# we need keep node /dev/fb0 open
		# graphic layer will disable after node /dev/fb0 is closed
		(
		exec 3<>/dev/fb0
		while true
		do
			sleep 65535
		done
		) &
	fi
	exit 0
fi
